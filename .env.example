# Mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/iptv
MQTT_CLIENT_ID=iptv-mqtt
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant

# IPTV playlist (channel list only; EPG comes from public XMLTV below)
M3U_URL=https://mybunny.tv/client/download.php?u=USER&p=PASS

# Public master XMLTV guide (~158MB, no auth). Override to use account-scoped guide:
# EPG_XML_URL=http://epg.mybunny.tv/btv/USER/PASS
EPG_XML_URL=https://mybunny.tv/epg.xml

# Cache the large public EPG file (seconds). CDN refreshes about every 5 minutes.
EPG_CACHE_TTL_SECONDS=900

# Polling (seconds); shortens to 15s within 5 minutes of a show ending
IPTV_POLL_INTERVAL_SECONDS=60
IPTV_CHANNEL_REFRESH_SECONDS=3600

LOG_LEVEL=INFO
